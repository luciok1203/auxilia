{
  "name": "wafflestudio-2025-fe-seminar-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "test:mobile": "node scripts/mobile-qa.cjs",
    "check:format": "biome check .",
    "check:unused": "knip",
    "fix": "biome check --write --unsafe .",
    "check-all": "yarn check:format && yarn check:unused",
    "fix-all": "yarn fix && yarn check-all",
    "ready": "yarn fix-all && yarn build"
  },
  "dependencies": {
    "@fontsource-variable/libre-baskerville": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-serif-kr": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "knip": "^5.59.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
